SGR_DB_URL=ENC(<cadena-jdbc-cifrada>)
SGR_DB_USERNAME=ENC(<usuario-app-cifrado>)
SGR_DB_PASSWORD=ENC(<clave-app-cifrada>)
SGR_DB_POOL_SIZE=10
SGR_MIGRATION_DB_USERNAME=ENC(<usuario-migracion-cifrado>)
SGR_MIGRATION_DB_PASSWORD=ENC(<clave-migracion-cifrada>)

# Base64 de, como mínimo, 32 bytes aleatorios (puede protegerse con ENC(...)).
SGR_JWT_SECRET=ENC(<secreto-jwt-cifrado>)
SGR_JWT_ISSUER=https://semaialabs.com
SGR_SECURE_COOKIE=true
