SGR_DB_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=SGR;encrypt=true;trustServerCertificate=false
SGR_DB_USERNAME=sgr_app
SGR_DB_PASSWORD=replace-with-a-long-random-password
SGR_DB_POOL_SIZE=10
SGR_MIGRATION_DB_USERNAME=sgr_migrator
SGR_MIGRATION_DB_PASSWORD=replace-with-a-different-random-password

# Base64 de, como mínimo, 32 bytes aleatorios.
SGR_JWT_SECRET=replace-with-base64-secret
SGR_JWT_ISSUER=https://semaialabs.com
SGR_SECURE_COOKIE=true

# Se usan una sola vez para crear el primer restaurante y propietario.
# Después del primer arranque, elimine estas cuatro variables del VPS.
SGR_BOOTSTRAP_OWNER_EMAIL=owner@example.com
SGR_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-password
SGR_BOOTSTRAP_OWNER_NAME=Propietario
SGR_BOOTSTRAP_ORGANIZATION_NAME=Restaurante inicial
